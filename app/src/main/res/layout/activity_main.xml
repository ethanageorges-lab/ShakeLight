<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShakeLight"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service actif en arrière-plan"
        android:textColor="#4CAF50"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/appSubtitle"
        android:layout_marginTop="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                app:lottie_rawRes="@raw/shake_anim"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sensibilité de la secousse (Force G)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Le Curseur (Slider) -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sensitivitySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="2.0"
                android:valueTo="12.0"
                android:value="6.0"
                android:stepSize="0.5"
                app:thumbColor="#4CAF50"
                app:trackColorActive="#4CAF50"
                app:trackColorInactive="#555555"/>

            <TextView
                android:id="@+id/tvSensitivityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valeur actuelle : 6.0"
                android:textColor="#B0B0B0"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Le Bouton Manuel -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTorch"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ALLUMER / ÉTEINDRE"
                app:backgroundTint="#2196F3"
                app:cornerRadius="8dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>